rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // 역할(Role) 판별 헬퍼 함수
    // 개인정보(이메일 등)를 코드에 남기지 않고 users 문서의 역할로만 판별합니다.
    // --------------------------------------------------

    // 최고 관리자(Admin) 판별: 지정된 교사 계정 또는 users/{uid} 문서의 role이 'admin'
    // (보안 규칙은 서버에서만 실행되므로 학생 F12 콘솔에 노출되지 않습니다)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'yool.ssam@gmail.com'
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 교사(Teacher) 판별: 최고 관리자이거나 users/{uid} 문서의 role이 'teacher'
    function isTeacher() {
      return request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // --------------------------------------------------
    // 담벼락 메모(memos) 컬렉션 규칙
    // --------------------------------------------------
    match /memos/{memoId} {
      // 1. 읽기: 누구나 가능
      allow read: if true;

      // 2. 작성: 로그인 필수 + 본인 UID + 5글자 이상
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5;

      // 3. 수정: 교사 또는 최고 관리자만 가능
      allow update: if isTeacher()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5;

      // 4. 삭제: 교사 또는 최고 관리자만 가능
      allow delete: if isTeacher();
    }

    // --------------------------------------------------
    // 사용자(users) 컬렉션 규칙 (교사 신청 및 승인)
    // --------------------------------------------------
    match /users/{userId} {
      // 본인 정보는 누구나 읽을 수 있고, 관리자는 모든 사용자 목록 조회 가능
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // 일반 사용자는 본인의 신청 정보 등록/수정 가능 (단, role을 직접 teacher/admin으로 바꾸는 것은 금지)
      allow create, update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == userId 
          && request.resource.data.role != 'admin'
          && request.resource.data.role != 'teacher'
        )
      );

      // 삭제는 최고 관리자만 가능
      allow delete: if isAdmin();
    }

  }
}
