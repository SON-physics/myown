rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // memos 컬렉션 규칙
    match /memos/{memoId} {
      // 1. 읽기: 누구나 가능
      allow read: if true;

      // 2. 작성: 문자열이면서 5글자 이상일 때만 허용
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() >= 5;

      // 3. 수정: 문자열이면서 5글자 이상일 때만 허용
      allow update: if request.resource.data.text is string
                    && request.resource.data.text.size() >= 5;

      // 4. 삭제: 허용
      allow delete: if true;
    }

  }
}
